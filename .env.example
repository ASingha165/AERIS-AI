# AERIS-AI Environment Configuration Example
# Copy to .env.local for local development. Never commit sensitive keys.

# Google Gemini API (Stage 3; server-side only)
GEMINI_API_KEY=

# OpenAQ API v3 Key (Stage 2; server-side only)
OPENAQ_API_KEY=

# Supabase (Stage 4; create a project before configuring these values)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only privileged key. Not used by the current app foundation.
# Never prefix this key with NEXT_PUBLIC_ or expose it to browser code.
SUPABASE_SERVICE_ROLE_KEY=

# Application Environment Mode
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_APP_VERSION=v2.5-stage4
