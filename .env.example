# AERIS-AI Environment Configuration Example
# Copy to .env.local for local development. Never commit sensitive keys.

# Google Gemini API (Stage 3 Integration)
GEMINI_API_KEY=

# OpenAQ API v3 Key (Stage 2 Integration)
OPENAQ_API_KEY=

# Supabase PostgreSQL Configuration (Stage 4 Integration)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Application Environment Mode
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_APP_VERSION=v2.4-stage1

